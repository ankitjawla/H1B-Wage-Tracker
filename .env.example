# Copy to .env and fill in. Do NOT commit .env (it is gitignored).

# --- Required: Mapbox token for the county wage map ---
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# --- Data Explorer (LCA / PERM / USCIS): Neon Postgres connection ---
# Server secret read by the Vercel /api/* serverless functions and by
# db/ingest.mjs. Set it in Vercel (Settings → Environment Variables) for the
# deployed app; put it here for local dev / ingestion. Never expose to the browser.
# Without it, the Data Explorer shows "Data unavailable".
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
