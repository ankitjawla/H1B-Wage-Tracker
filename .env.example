# Copy to .env and fill in. Do NOT commit .env (it is gitignored).

# --- Required: Mapbox token for the county wage map ---
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# --- Optional: override the Data Explorer's Supabase project ---
# The app ships with working defaults baked into src/utils/supabase.js (the
# publishable key is public/browser-safe). Only set these to point at a
# different Supabase project.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# --- Ingestion only (db/ingest.mjs on a real machine) ---
# Postgres connection string from Supabase → Settings → Database.
# SUPABASE_DB_URL=postgres://postgres:password@db.your-project.supabase.co:5432/postgres
