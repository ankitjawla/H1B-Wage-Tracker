# Copy to .env and fill in. Do NOT commit .env (it is gitignored).

# --- Required: Mapbox token for the county wage map ---
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# --- Optional: Neon Postgres for the Data Explorer (LCA/PERM/USCIS) ---
# Provided automatically when you add the Neon integration in the Vercel
# dashboard (Storage → Neon). Locally, paste your Neon connection string.
# Without it, the Data Explorer falls back to clearly-labeled sample data.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
